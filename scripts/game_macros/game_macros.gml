function game_macros()
{
	// Collision macros
	#macro PLANE_A 0
	#macro PLANE_B 1
	
	// Collision side macros
	#macro C_MAIN 0
	#macro C_BOTTOM 1
	#macro C_TOP 2
	#macro C_LEFT 3
	#macro C_RIGHT 4
	
	// Collision mode macros
	#macro CMODE_FLOOR 0
	#macro CMODE_LWALL 1
	#macro CMODE_RWALL 3
	#macro CMODE_CEILING 2
}